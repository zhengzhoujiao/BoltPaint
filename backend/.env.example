# ============================================================
# 配置文件说明
# ============================================================
# .env          — 公开模板（已提交 git），包含非敏感默认值
# .env.local    — 本地开发敏感配置（已 gitignore，不会提交）
# .env.production  — 生产环境敏感配置（已 gitignore，不会提交）
#
# 使用方式：
#   本地开发：复制此文件为 .env，再创建 .env.local 填入真实密钥
#   生产部署：复制此文件为 .env，再创建 .env.production 填入真实密钥
# ============================================================

# ==================== 环境配置 (dev / prod) ====================
APP_ENV=dev

# ==================== MongoDB 配置 ====================
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=bolt_painting

# ==================== API 配置 ====================
API_HOST=0.0.0.0
API_PORT=8000

# ==================== CORS 配置 ====================
CORS_ORIGINS=*

# ==================== Google Gemini API 配置 ====================
NANO_BANANA_API_KEY=

# ==================== Evolink 中转站 API 配置 ====================
EVOLINK_API_KEY=
EVOLINK_API_BASE_URL=https://api.evolink.ai

# ==================== 业务配置 ====================
COST_PER_GENERATION=10

# ==================== 支付宝直连配置 ====================
# 正式环境网关：https://openapi.alipay.com/gateway.do
# 沙箱网关：https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 示例：https://www.bolt-series.cn/boltPaint/api/orders/alipay/notify
ALIPAY_NOTIFY_URL=
# 示例：https://www.bolt-series.cn/boltPaint/api/orders/alipay/return
ALIPAY_RETURN_URL=
# 示例：https://www.bolt-series.cn/boltPaint/#/payment/result
PAYMENT_RESULT_URL=

# ==================== 阿里云短信配置 ====================
SMS_ENABLED=false
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_RESET_TEMPLATE_CODE=

# ==================== 密码加密 ====================
PASSWORD_ENCRYPTION_KEY=

# ==================== 首次初始化账户 ====================
# 仅在 users 集合为空时使用；请设置强密码，初始化后可从运行环境移除。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_TEST_USER_PASSWORD=

# ==================== 图片存储 ====================
OBJECT_STORAGE_DIR=
